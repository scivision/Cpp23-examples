{
  "version": 6,

"configurePresets": [
{
  "name": "default",
  "binaryDir": "build",
  "generator": "Ninja",
  "cacheVariables": {
    "CMAKE_BUILD_TYPE": "Release",
    "CMAKE_COMPILE_WARNING_AS_ERROR": true,
    "CMAKE_LINK_WARNING_AS_ERROR": true
  }
},
{ "name": "build", "inherits": "default"},
{
  "name": "debug", "inherits": "default",
  "cacheVariables": {
    "CMAKE_BUILD_TYPE": "Debug"
  }
},
{
  "name": "msvc", "inherits": "default",
  "generator": "Visual Studio 18 2026",
  "condition": {
    "type": "equals",
    "lhs": "${hostSystemName}",
    "rhs": "Windows"
  }
},
{ "name": "clangcl", "inherits": "msvc",
  "displayName": "Clang-cl with MSVC",
  "description": "Build with Clang-cl using MSVC toolchain.",
  "toolset": "ClangCL"
}
],
"buildPresets": [
  {
    "name": "default",
    "configurePreset": "default",
    "configuration": "Release",
    "jobs": 0
  },
  { "name": "build", "inherits": "default", "configurePreset": "build" },
  { "name": "msvc", "inherits": "default", "configurePreset": "msvc", "jobs": 8 },
  { "name": "clangcl", "configurePreset": "clangcl", "inherits": "msvc" },
  { "name": "debug", "configurePreset": "debug", "configuration": "Debug" }
],
"testPresets": [
{
  "name": "default",
  "configurePreset": "default",
  "configuration": "Release",
  "output": {
    "outputOnFailure": true,
    "verbosity": "verbose"
  },
  "execution": {
    "noTestsAction": "error",
    "scheduleRandom": true,
    "stopOnFailure": false,
    "jobs": 8
  }
},
{ "name": "msvc", "inherits": "default", "configurePreset": "msvc" },
{ "name": "clangcl", "configurePreset": "clangcl", "inherits": "msvc" },
{
  "name": "debug", "inherits": "default",
  "configurePreset": "debug",
  "configuration": "Debug"
}
],
"workflowPresets": [
  {
    "name": "default",
    "displayName": "build and test",
    "steps": [
      { "type": "configure", "name": "default" },
      { "type": "build", "name": "default" },
      { "type": "test", "name": "default" }
    ]
  },
  {
    "name": "build",
    "displayName": "build only",
    "steps": [
      { "type": "configure", "name": "build" },
      { "type": "build", "name": "build" }
    ]
  },
  {
    "name": "debug",
    "displayName": "Debug build and test",
    "steps": [
      { "type": "configure", "name": "debug" },
      { "type": "build", "name": "debug" },
      { "type": "test", "name": "debug" }
    ]},
  {
    "name": "msvc",
    "displayName": "MSVC build and test",
    "steps": [
      { "type": "configure", "name": "msvc" },
      { "type": "build", "name": "msvc" },
      { "type": "test", "name": "msvc" }
    ]},
  { "name": "clangcl",
    "steps": [
      { "type": "configure", "name": "clangcl" },
      { "type": "build", "name": "clangcl" },
      { "type": "test", "name": "clangcl" }
    ]}
]
}
